# macOS
.DS_Store

# Xcode / build
DerivedData/
build/
*.xcresult
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# XcodeGen generates the project — source of truth is project.yml
Bloom.xcodeproj/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# CocoaPods / Carthage (unused, but ignore if added)
Pods/
Carthage/Build/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Secrets — never commit
*.env
.env
secrets.xcconfig

# Snapshot test failure artifacts (keep __Snapshots__ references, ignore failures)
**/__Snapshots__/**/*.failure.png

# Product/research docs — kept LOCAL, deliberately NOT published to the public remote.
# These specs (product brief, clinical research, partner-sharing privacy strategy,
# build plans, stage handoffs) stay on the developer's machine only.
docs/
