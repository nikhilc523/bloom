<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bloom syncs her PRIVATE store only, to her own iCloud private database.
	     No shared/public zone here — the partner layer (Stage 11) is CloudKit-direct
	     + CKShare and is deliberately absent. This container id must match
	     BloomStore.cloudKitContainerID. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.nikhilc523.bloom</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Silent pushes wake the app to pull remote changes. `development` here;
	     Xcode rewrites it to `production` for a release/TestFlight build. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Stage 5 — HealthKit two-way sync with Apple Cycle Tracking. `background-delivery`
	     lets external Health changes (Apple Watch, other apps) wake Bloom to ingest
	     them. Requires the HealthKit capability on the App ID (Developer portal) and
	     the target (Xcode picks it up under Automatic signing). HealthKit data is a
	     separate source and is never written into the CloudKit-mirrored store (5.1.3). -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.background-delivery</key>
	<true/>
</dict>
</plist>
