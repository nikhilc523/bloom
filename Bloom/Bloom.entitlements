<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bloom syncs her PRIVATE store only, to her own iCloud private database.
	     No shared/public zone here — the partner layer (Stage 11) is CloudKit-direct
	     + CKShare and is deliberately absent. This container id must match
	     BloomStore.cloudKitContainerID. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.nikhilc523.bloom</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Silent pushes wake the app to pull remote changes. `development` here;
	     Xcode rewrites it to `production` for a release/TestFlight build. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
